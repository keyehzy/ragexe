# Writes a C++ header holding files as byte arrays, for shaders compiled during the build.
#
#   cmake -DOUTPUT=out.h -DFILES="name1=path1|name2=path2" -P embed_files.cmake
#
# Each name becomes `inline constexpr unsigned char name[]`, the file's bytes followed by a
# NUL (text such as MSL can then be read as a string), and `name_size`, the byte count
# without it.

set(text "// Generated by cmake/embed_files.cmake.\n#pragma once\n\n#include <cstddef>\n\n")
string(REPLACE "|" ";" FILES "${FILES}")
foreach(entry IN LISTS FILES)
  string(REPLACE "=" ";" parts "${entry}")
  list(GET parts 0 name)
  list(GET parts 1 path)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" digits)
  math(EXPR size "${digits} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x..,){24})" "\\1\n    " bytes "${bytes}")
  string(APPEND text "inline constexpr unsigned char ${name}[] = {\n    ${bytes}0x00};\n")
  string(APPEND text "inline constexpr std::size_t ${name}_size = ${size};\n\n")
endforeach()
file(WRITE "${OUTPUT}.tmp" "${text}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
