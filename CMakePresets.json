{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "RAGEXE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RAGEXE_SANITIZE": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Optimised with debug information",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer targets, optimised, with AddressSanitizer and UndefinedBehaviorSanitizer (set CC and CXX to LLVM Clang)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "RAGEXE_SANITIZE": "ON",
        "RAGEXE_FUZZ": "ON",
        "FETCHCONTENT_TRY_FIND_PACKAGE_MODE": "NEVER"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 300 },
      "environment": { "SDL_VIDEO_DRIVER": "dummy", "SDL_AUDIO_DRIVER": "dummy" }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 300 },
      "environment": { "SDL_VIDEO_DRIVER": "dummy", "SDL_AUDIO_DRIVER": "dummy" }
    }
  ]
}
